# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secondbrain
DB_USER=secondbrain
DB_PASSWORD=your_password_here

# LLM API (configure via settings page after login)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small

# 对外 API/MCP 基地址（网页「设置」页会展示给用户接入智能体用）
# 例如: PUBLIC_BASE_URL=http://39.96.27.17:8000
PUBLIC_BASE_URL=

# ── 站点形态 ──────────────────────────────────────────
# 是否允许公开注册：false = 个人知识库（默认，仅本人使用）；true = 开放注册
ALLOW_SIGNUP=false
# 页脚备案号，如 京ICP备2026000000号-1（留空则不显示）
SITE_ICP=
# 页脚联系方式（留空则不显示）
SITE_CONTACT=
SITE_NAME=第二大脑

# 功能开关：false = 该模块不出现在导航里（代码保留，改 true 重启即恢复）
# 一键切换：venv/bin/python tools/toggle_feature.py all on
ENABLE_CHAT=false
ENABLE_SETTINGS=false

# 邮件（找回密码验证码）—— QQ 邮箱示例：
#   1) QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成「授权码」
#   2) 下面 SMTP_PASS 填授权码，不是 QQ 登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 验证码有效期（秒），默认 10 分钟
RESET_CODE_TTL=600
