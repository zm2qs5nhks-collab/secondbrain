# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=secondbrain
DB_USER=secondbrain
DB_PASSWORD=your_password_here

# LLM API (configure via settings page after login)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-v4-flash
EMBEDDING_MODEL=text-embedding-3-small

# 对外 API/MCP 基地址（网页「设置」页会展示给用户接入智能体用）
# 例如: PUBLIC_BASE_URL=http://39.96.27.17:8000
PUBLIC_BASE_URL=

# 邮件（找回密码验证码）—— QQ 邮箱示例：
#   1) QQ 邮箱 → 设置 → 账户 → 开启 SMTP 服务 → 生成「授权码」
#   2) 下面 SMTP_PASS 填授权码，不是 QQ 登录密码
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# 验证码有效期（秒），默认 10 分钟
RESET_CODE_TTL=600
