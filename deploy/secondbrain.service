[Unit]
Description=Second Brain Streamlit App
After=network.target postgresql.service

[Service]
Type=simple
User=root
WorkingDirectory=/root/secondbrain
ExecStart=/root/secondbrain/venv/bin/streamlit run app.py --server.port 8501 --server.address 0.0.0.0
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
